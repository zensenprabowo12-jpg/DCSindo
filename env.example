# Salin ke .env lalu sesuaikan (file .env tidak di-commit)

# Database — server produksi memakai MariaDB (bukan MySQL), dibaca oleh
# server/config/mysqlPool.ts. Nama variabelnya HARUS berawalan DB_; prefix
# MYSQL_ yang dipakai versi lama berkas ini tidak dibaca kode mana pun dan
# membuat server gagal start dengan pesan: [MySQL] ENV "DB_USER" wajib di-set.
#
# DB_SOCKET diisi HANYA kalau memakai UNIX socket (server Linux). Kalau diisi,
# DB_HOST dan DB_PORT diabaikan. Kosongkan untuk koneksi TCP biasa.
DB_SOCKET=
DB_HOST=localhost
DB_PORT=3306
DB_USER=dcsnewdb
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
# DB_NAME, bukan DB_DATABASE — harus sama persis dengan nama database di server.
DB_NAME=dcsindo

# Port server (Replit / hosting memakai PORT dari environment)
PORT=5000

# Wajib di production (untuk session express-session)
SESSION_SECRET=change-me-in-production

# --- Kredensial login panel admin (/admin) ---
# Dipakai HANYA untuk seed admin pertama, saat tabel `users` masih kosong.
# Kalau salah satu tidak di-set, seed admin DILEWATI — tidak ada nilai default.
# Ganti password setelah login lewat panel /admin/users, bukan lewat file ini.
ADMIN_USER=CHANGE_ME_BEFORE_FIRST_BOOT
ADMIN_PASS=CHANGE_ME_BEFORE_FIRST_BOOT

# NODE_ENV=production

# Feature flags aplikasi kini lewat runtime JSON (tanpa npm run build):
# - Edit di server (misal via WinSCP): client/public/truefalse.json (path deploy: /truefalse.json)
# Field: disableMikrotikRoutes, disableUbiquitiAccessories, showAddons
