# Salin ke .env lalu sesuaikan (file .env tidak di-commit)

# MySQL — dipakai katalog MikroTik + katalog multi-brand (brands/products)
# Note: Backend boleh pakai "localhost" jika MySQL ada di server yang sama (phpMyAdmin/MySQL server).
# MYSQL_DATABASE harus persis sama dengan nama database yang ada di server MySQL.
# Jika error "Unknown database", buat dulu: lihat database/00_create_database.sql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dcsnewdb
MYSQL_PASSWORD=YOUR_DB_PASSWORD_HERE
MYSQL_DATABASE=dcsindo

# Port server (Replit / hosting memakai PORT dari environment)
PORT=5000

# Wajib di production (untuk session express-session)
SESSION_SECRET=change-me-in-production

# --- Kredensial login panel admin (/admin) ---
# Ganti password admin cukup ubah ADMIN_PASS di bawah, lalu restart server.
# Kalau dua baris ini tidak di-set, kode pakai default: admin / MBGratisdcsindo
ADMIN_USER=admin
ADMIN_PASS=MBGratisdcsindo

# NODE_ENV=production

# Feature flags aplikasi kini lewat runtime JSON (tanpa npm run build):
# - Edit di server (misal via WinSCP): client/public/truefalse.json (path deploy: /truefalse.json)
# Field: disableMikrotikRoutes, disableUbiquitiAccessories, showAddons
