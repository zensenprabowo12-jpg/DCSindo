<%- include('../../mikrotik/views/layouts/shell-start') %>
<div class="wrap">
  <h1><%= brand.nama_brand %></h1>
  <p class="muted" style="margin-top:0;">Katalog produk</p>

  <% if (!products.length) { %>
    <div class="card" style="margin-top:1.5rem;">
      <p>Belum ada produk untuk brand ini.</p>
    </div>
  <% } else { %>
    <div class="grid" style="margin-top:1.5rem;">
      <% products.forEach(function (p) { %>
        <a href="/brand/<%= brand.slug %>/<%= p.id %>" class="card" style="text-decoration:none;color:inherit;display:block;">
          <% if (p.gambar) { %>
            <img class="thumb" src="<%= p.gambar %>" alt="<%= p.nama_produk %>" />
          <% } else { %>
            <div class="thumb"></div>
          <% } %>
          <h2 style="margin-top:0.75rem;"><%= p.nama_produk %></h2>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>
<%- include('../../mikrotik/views/layouts/shell-end') %>
