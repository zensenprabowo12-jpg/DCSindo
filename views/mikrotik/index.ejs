<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <a class="logo" href="/">DCS — Katalog</a>
      <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
        <a href="/">Beranda React</a>
        <a href="/admin/mikrotik" class="btn btn-ghost">Admin</a>
      </div>
    </div>

    <h1>MikroTik</h1>
    <p class="muted" style="margin-top:0;">Produk jaringan — harga dapat dikosongkan di database.</p>

    <% if (!products.length) { %>
      <div class="card" style="margin-top:1.5rem;">
        <p>Belum ada produk. Tambah dari <a href="/admin/mikrotik">dashboard admin</a>.</p>
      </div>
    <% } else { %>
      <div class="grid" style="margin-top:1.5rem;">
        <% products.forEach(function (p) { %>
          <a href="/mikrotik/<%= p.id %>" class="card" style="text-decoration:none;color:inherit;display:block;">
            <% if (p.gambar) { %>
              <img class="thumb" src="<%= p.gambar %>" alt="<%= p.nama_produk %>" />
            <% } else { %>
              <div class="thumb"></div>
            <% } %>
            <h2 style="margin-top:0.75rem;"><%= p.nama_produk %></h2>
            <% if (p.harga) { %>
              <p class="muted" style="margin:0;">Rp <%= Number(p.harga).toLocaleString('id-ID') %></p>
            <% } else { %>
              <p class="muted" style="margin:0;">Hubungi kami untuk harga</p>
            <% } %>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>
