<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <a class="logo" href="/mikrotik">← Katalog MikroTik</a>
      <a href="/">Beranda</a>
    </div>

    <div class="card">
      <div style="display:grid;grid-template-columns:1fr;gap:1.25rem;">
        <% if (product.gambar) { %>
          <img src="<%= product.gambar %>" alt="<%= product.nama_produk %>" style="width:100%;max-width:420px;border-radius:0.5rem;" />
        <% } %>
        <div>
          <h1><%= product.nama_produk %></h1>
          <% if (product.harga) { %>
            <p style="font-size:1.25rem;font-weight:600;margin:0.25rem 0 1rem;">Rp <%= Number(product.harga).toLocaleString('id-ID') %></p>
          <% } else { %>
            <p class="muted" style="margin:0.25rem 0 1rem;">Harga: hubungi kami</p>
          <% } %>
          <h2 style="margin-top:0;">Deskripsi</h2>
          <p style="white-space:pre-wrap;"><%= product.deskripsi %></p>
          <h2>Spesifikasi</h2>
          <p style="white-space:pre-wrap;"><%= product.spesifikasi %></p>
          <p class="muted" style="font-size:0.8rem;margin-top:1.5rem;">Diarsipkan: <%= new Date(product.created_at).toLocaleString('id-ID') %></p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
