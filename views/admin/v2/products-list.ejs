<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <a class="logo" href="/admin/v2/products">Admin — Katalog v2</a>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
        <a href="/admin/mikrotik" class="btn btn-ghost">Admin MikroTik (lama)</a>
        <a href="/admin/v2/products/new" class="btn">+ Produk</a>
      </div>
    </div>

    <% 
      var err = typeof query.error === 'string' ? query.error : (query.error && query.error[0]);
      var ok = typeof query.success === 'string' ? query.success : (query.success && query.success[0]);
    %>
    <% if (ok) { %><div class="flash flash-ok"><%= ok %></div><% } %>
    <% if (err) { %><div class="flash flash-err"><%= err %></div><% } %>

    <h1>Semua produk (JOIN brand)</h1>
    <p class="muted">Satu tabel <code>products</code> + <code>brands</code>. API: <code>GET /api/products?brand=mikrotik</code></p>

    <% if (!products.length) { %>
      <p style="margin-top:1rem;">Belum ada produk.</p>
    <% } else { %>
      <div class="card" style="margin-top:1rem;overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Brand</th>
              <th>Gambar</th>
              <th>Nama</th>
              <th>Harga</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function (p) { %>
              <tr>
                <td><%= p.id %></td>
                <td><%= p.nama_brand %><br /><span class="muted" style="font-size:0.75rem;"><%= p.brand_slug %></span></td>
                <td>
                  <% if (p.gambar) { %>
                    <img src="<%= p.gambar %>" alt="" style="width:56px;height:42px;object-fit:cover;border-radius:4px;" />
                  <% } else { %>—<% } %>
                </td>
                <td><%= p.nama_produk %></td>
                <td><%= p.harga ? 'Rp ' + Number(p.harga).toLocaleString('id-ID') : '—' %></td>
                <td style="white-space:nowrap;">
                  <a href="/brand/<%= p.brand_slug %>/<%= p.id %>">Lihat</a>
                  ·
                  <a href="/admin/v2/products/<%= p.id %>/edit">Edit</a>
                  <form action="/admin/v2/products/<%= p.id %>/delete" method="post" style="display:inline;margin-left:0.5rem;" onsubmit="return confirm('Hapus produk ini?');">
                    <button type="submit" class="btn btn-danger" style="padding:0.25rem 0.5rem;font-size:0.8rem;">Hapus</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="card" style="margin-top:1.5rem;">
      <h2 style="margin-top:0;">Brand terdaftar</h2>
      <ul class="muted" style="margin:0;padding-left:1.25rem;">
        <% brands.forEach(function (b) { %>
          <li><a href="/brand/<%= b.slug %>"><%= b.nama_brand %></a> — <code><%= b.slug %></code></li>
        <% }); %>
      </ul>
    </div>
  </div>
</body>
</html>
